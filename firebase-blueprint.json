{
  "entities": {
    "AllowedStudent": {
      "title": "Allowed Student",
      "description": "학원 학생 이메일 목록",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "학생의 구글 계정 이메일"
        },
        "name": {
          "type": "string",
          "description": "학생 이름"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "등록 일시"
        }
      },
      "required": ["email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "관리자 목록",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/allowedStudents/{studentId}": {
      "schema": "AllowedStudent",
      "description": "접근 가능한 학생 목록"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "관리자 목록"
    }
  }
}
