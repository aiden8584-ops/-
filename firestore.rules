rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: allowedStudents
    // Fields:
    //   - email: string (required)
    //   - name: string (optional)
    //   - addedAt: timestamp
    //
    // Collection: admins
    // Fields:
    //   - email: string (required)
    //   - role: string (required, 'admin')
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "aiden8584@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Allowed Students Collection
    match /allowedStudents/{studentId} {
      // 누구나 자신의 이메일이 있는지 확인하기 위해 읽기 가능 (쿼리용)
      // 하지만 실제로는 학생 목록 전체를 보는 것은 관리자만 가능하게 함
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
